# --- LLM provider (the ONLY place real provider keys live) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional alternative provider: fill this and set LLM_MODEL=chat-openai —
# the swap is env-only, no code changes (ADR-0001/0002).
OPENAI_API_KEY=
LLM_MODEL=chat

# --- LiteLLM gateway ---
# Master key for the LiteLLM proxy admin API — issues/revokes keys, ops only.
LITELLM_MASTER_KEY=sk-litellm-master-change-me
# Password for the gateway's Postgres (virtual keys, budgets, spend — ADR-0006).
LITELLM_PG_PASSWORD=change-me-random-password
# Key the agent uses to call the gateway. Works with the master key out of the
# box; harden by issuing a budgeted virtual key: ./gateway/issue-key.sh
LITELLM_API_KEY=sk-litellm-master-change-me

# --- MCP server auth ---
MCP_AUTH_TOKEN=change-me-random-token

# --- A2A: orchestrator → specialist agents (ADR-0008) ---
A2A_AUTH_TOKEN=change-me-another-random-token

# --- Langfuse Cloud (optional — tracing off if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
