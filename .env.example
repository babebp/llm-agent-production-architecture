# --- LLM provider (the ONLY place real provider keys live) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional alternative provider: fill this and set LLM_MODEL=chat-openai —
# the swap is env-only, no code changes (ADR-0001/0002).
OPENAI_API_KEY=
LLM_MODEL=chat

# --- LiteLLM gateway ---
# Master key for the LiteLLM proxy admin API.
LITELLM_MASTER_KEY=sk-litellm-master-change-me
# Key the agent uses to call the gateway.
# Demo: reuse the master key. Production: issue a virtual key with budget/rate
# limits via LiteLLM's /key/generate (requires a Postgres-backed LiteLLM).
LITELLM_API_KEY=sk-litellm-master-change-me

# --- MCP server auth ---
MCP_AUTH_TOKEN=change-me-random-token

# --- Langfuse Cloud (optional — tracing off if unset) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
